{
  "name": "paper",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "npx wrangler pages dev ./public --port 8788",
    "typecheck": "tsc --noEmit",
    "test": "node --no-warnings --test tests/backend/*.test.js",
    "check:syntax": "find functions -type f -name '*.js' -exec node --check {} \\; && node --check static/sw.js",
    "build": "npm run typecheck && vite build",
    "build:functions": "npx wrangler pages functions build --outdir /tmp/opencode/paper-functions-build",
    "check": "npm run check:syntax && npm run test && npm run build && npm run build:functions",
    "preview": "vite preview"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.61.9",
    "@clerk/localizations": "^4.15.4",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/noto-sans-thai": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-slot": "^1.3.0",
    "@tanstack/react-query": "^5.102.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^7.18.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.0.0"
  }
}
